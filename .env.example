# Sao chép thành server/.env (hoặc export biến môi trường). KHÔNG commit file .env thật.
PORT=4000
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai
COOKIE_SECURE=0                      # đặt 1 khi chạy sau HTTPS

# Đăng nhập Google (Google Identity Services). Tạo OAuth Client ID loại "Web application",
# thêm http://localhost:4000 và http://localhost:5173 vào "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# AUTH_DEV=1                         # chỉ để thử khi chưa có Google Client ID (đăng nhập bằng email bất kỳ)

# Lưu trữ: seaweedfs | s3 | local
STORAGE_DRIVER=seaweedfs
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gallery
S3_ACCESS_KEY=gallery-dev-key        # khớp seaweed/s3.json (khóa mẫu, không phải khóa thật)
S3_SECRET_KEY=gallery-dev-secret
# LOCAL_STORAGE_ROOT=./data/uploads  # khi STORAGE_DRIVER=local

DB_PATH=./data/gallery.db
OLD_VERSION_TTL_MS=3600000           # giữ file version cũ 1 giờ sau khi chỉnh sửa rồi xóa
# DEBUG_FAULTS=1                     # chỉ khi nghiệm thu: cho phép ?fail=db|storage để gây lỗi có chủ đích
